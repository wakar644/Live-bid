# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=auction_user
DATABASE_PASSWORD=auction_password
DATABASE_NAME=auction_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400

# App
NODE_ENV=development
PORT=3000

# Anti-sniping
ANTI_SNIPE_THRESHOLD_SECONDS=10
ANTI_SNIPE_EXTENSION_SECONDS=30
